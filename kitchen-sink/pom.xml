<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kitchen-sink reference app (T-3.1): resolves every spring-boot-starter-* of Spring Boot 2.7.18
  plus devtools, configuration-processor and properties-migrator, for dependency inventory and scanning.
  Not meant to be compiled or run. Mutually exclusive starters (tomcat/jetty/undertow, logging/log4j2)
  are intentionally kept together.
-->
